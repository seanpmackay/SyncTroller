{
  "name": "hue-sync-controller",
  "version": "1.2.1",
  "description": "Standalone desktop controller for the Philips Hue Play HDMI Sync Box",
  "main": "src/main.js",
  "author": "RoodleSoft",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "install:desktop": "bash packaging/install-user.sh"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.seanmackay.huesynccontroller",
    "productName": "SyncTroller",
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "homepage": "https://github.com/seanpmackay/SyncTroller",
  "repository": {
    "type": "git",
    "url": "https://github.com/seanpmackay/SyncTroller.git"
  }
}
