# Maintainer: Sean MacKay <sean.p.mackay@gmail.com>
#
# Binary package built from the prebuilt electron-builder tarball attached to
# each GitHub release. To publish a new version to the AUR:
#
#   1. npm run dist && gh release create v<ver> dist/SyncTroller-<ver>.{AppImage,tar.gz}
#   2. bump pkgver, reset pkgrel=1, run `updpkgsums`
#   3. makepkg --printsrcinfo > .SRCINFO
#   4. commit + push in the AUR clone (ssh://aur@aur.archlinux.org/synctroller-bin.git)

pkgname=synctroller-bin
_pkgname=synctroller
pkgver=1.2.0
pkgrel=1
pkgdesc="Standalone desktop controller for the Philips Hue Play HDMI Sync Box"
arch=('x86_64')
url="https://github.com/seanpmackay/SyncTroller"
license=('MIT')
depends=('gtk3' 'nss' 'libxss' 'libxtst' 'at-spi2-core' 'libdrm' 'mesa' 'alsa-lib' 'nspr' 'libnotify')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!emptydirs')
source=("SyncTroller-$pkgver.tar.gz::$url/releases/download/v$pkgver/SyncTroller-$pkgver.tar.gz"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/seanpmackay/SyncTroller/v$pkgver/LICENSE"
        "icon-$pkgver.png::https://raw.githubusercontent.com/seanpmackay/SyncTroller/v$pkgver/assets/icon.png"
        "$_pkgname.desktop")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
  install -dm755 "$pkgdir/opt/$_pkgname"
  cp -a "$srcdir/SyncTroller-$pkgver/." "$pkgdir/opt/$_pkgname/"

  install -dm755 "$pkgdir/usr/bin"
  ln -s "/opt/$_pkgname/hue-sync-controller" "$pkgdir/usr/bin/$_pkgname"

  install -Dm644 "$srcdir/$_pkgname.desktop" \
    "$pkgdir/usr/share/applications/$_pkgname.desktop"
  install -Dm644 "$srcdir/icon-$pkgver.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_pkgname.png"

  install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
